# Clerk API keys, from the API keys page of your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public address of this site, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the analysis app (the Frontend folder) is served.
NEXT_PUBLIC_ANALYZER_URL=http://127.0.0.1:5173

# Where the analysis API (the Backend folder) is served. The dashboard shows whether it is up.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
